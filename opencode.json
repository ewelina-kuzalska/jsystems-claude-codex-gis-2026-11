{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "git push*": "deny",
      "git commit*": "deny",
      "git reset*": "deny",
      "env*": "deny",
      "printenv*": "deny",
      "curl*": "deny",
      "wget*": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny"
  }
}
